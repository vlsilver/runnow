	<key>NSHealthShareUsageDescription</key>
	<string>3i Run đọc các buổi chạy từ app Sức khoẻ để cập nhật quãng đường và bảng xếp hạng của bạn.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>3i Run không ghi dữ liệu vào Sức khoẻ; quyền này chỉ để hoàn tất kết nối HealthKit.</string>
