	<string>3i Run cần micro khi bạn bật nói chuyện với người chạy cùng phòng.</string>
	<key>NSCameraUsageDescription</key>
	<string>3i Run cần camera để chụp ảnh và neo ảnh vào hành trình chạy của bạn.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>3i Run lưu ảnh thẻ, recap và ảnh bạn chọn chia sẻ vào thư viện Ảnh.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>3i Run cần quyền vị trí nền khi bạn khoá màn hình hoặc dùng app khác trong lúc đang chạy.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>3i Run cần quyền vị trí nền khi bạn khoá màn hình hoặc dùng app khác trong lúc đang chạy.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
