rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/activities/{activityId}/photos/{fileName} {
      // Bất kỳ user đã đăng nhập nào cũng xem được — kèo/live cần chia sẻ
      // ảnh giữa người tham gia bất kể profile public/private, và quyết
      // định là mở hẳn cho mọi user thay vì giới hạn theo từng kèo.
      allow read: if signedIn();
      allow create, update: if owns(userId)
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
      allow delete: if owns(userId);
    }

    match /users/{userId}/avatar/{fileName} {
      allow read: if signedIn();
      allow create, update: if owns(userId)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg');
      allow delete: if owns(userId);
    }

    // Ảnh minh hoạ mốc "Hành Trình" — nội dung tĩnh do 3i quản lý (upload
    // qua CLI khi dựng dữ liệu route), không phải nội dung user tạo nên
    // không có client write nào.
    match /journey/photos/{fileName} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
